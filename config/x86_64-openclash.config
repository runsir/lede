# ============================================================================
# x86_64 固件包选择（seed config）
#
# 用法：cp configs/x86_64-openclash.config .config && make defconfig
# 说明：这里只写“要什么 / 不要什么”，其余几千个选项交给 make defconfig
#       按依赖关系自动补齐，因此上游更新后也不容易失效。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 目标平台：x86 / 64 位，通用设备
# ---------------------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------------------------------------------------------------------------
# 2. 固件格式
#    - squashfs：系统分区只读 + overlay，刷坏可恢复，软路由首选
#    - 1 GiB 根分区：放得下 OpenClash 的 ruby 运行时和后续 ipk
#    - 同时产出 BIOS(combined) 和 UEFI(combined-efi) 两种镜像
# ---------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_IMAGES_GZIP=y

# ---------------------------------------------------------------------------
# 3. Web 界面
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-app-ttyd=y

# 中文界面（zh_Hans 会自动带上所有已装插件的 zh-cn 翻译包）
CONFIG_LUCI_LANG_zh_Hans=y

# ---------------------------------------------------------------------------
# 4. OpenClash 及其运行时依赖
#    OpenClash 的 Makefile 已经声明了 dnsmasq-full / bash / curl / ca-bundle /
#    ip-full / ruby / ruby-yaml / kmod-tun / unzip，这里显式写出来是为了：
#      a) 让 .config 可读、可审查
#      b) 一旦上游依赖改名，CI 的校验步骤会立刻报错，而不是悄悄少装东西
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-openclash=y

# 防火墙是 firewall4(nftables)：OpenClash 的规则直接挂在 `inet fw4` 表上，
# 所以 kmod-nft-tproxy / dnsmasq 的 nftset 支持是旁路模式的关键。
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# OpenClash 0.46+ 用 ruby 解析/改写 YAML 配置（订阅、覆写、规则编辑）
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y

# 关掉 ruby 的 JIT：YJIT/ZJIT 依赖 rust/host，交叉编译下官方也标记为 BROKEN，
# 打开后编译时间会翻倍且大概率失败；OpenClash 解析 YAML 用不到 JIT。
# CONFIG_RUBY_ENABLE_YJIT is not set
# CONFIG_RUBY_ENABLE_ZJIT is not set

# ---------------------------------------------------------------------------
# 5. 去掉 Lean 默认打包的其它插件，做到「只带 OpenClash」
#    这些包在 include/target.mk 的 DEFAULT_PACKAGES.router 里，必须显式 =n
# ---------------------------------------------------------------------------
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_ddns-scripts_aliyun is not set
# CONFIG_PACKAGE_ddns-scripts_dnspod is not set

# 不用 Lean 的 default-settings：它依赖一些历史语言符号，而且会改 opkg 源。
# 时区 / root 密码 / 主机名改由 configs/zz-openclash-bypass 在首次启动时写入。
# CONFIG_PACKAGE_default-settings is not set
